# 复制为 deploy/.env（不进 git）后按需修改；docker compose 会自动读取本目录 .env。
# 宿主访问端口（仅绑定 127.0.0.1）：浏览器打开 http://127.0.0.1:<ERP_WEB_PORT>
ERP_WEB_PORT=8080

# 生产务必替换为随机 32+ 字节密钥
ERP_JWT_SECRET=change-me-to-a-random-32-bytes
ERP_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 首次 seed 的管理员（幂等；登录后请改密）
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=admin123

# 经 nginx 同源反代时通常无跨域；这里保留直连调试来源
ERP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ERP_ENV=prod

# 附件上传大小上限（MB；容器 nginx 的 client_max_body_size 固定 12m 兜底）
ERP_ATTACHMENT_MAX_SIZE_MB=10

# 可选：构建期镜像源（留空则用官方源；中国网络下可加速）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
