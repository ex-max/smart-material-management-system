# 复制为 .env 并按需修改；.env 不进仓库
ERP_DATABASE_URL=postgresql+psycopg://erp:erp@127.0.0.1:5433/erp
ERP_JWT_SECRET=change-me-to-a-random-32-bytes
ERP_ACCESS_TOKEN_EXPIRE_MINUTES=120
ERP_CORS_ORIGINS=http://localhost:5173
ERP_ENV=dev
# 数据迁移种子管理员口令（首次登录后请立即修改）
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=admin123
